root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.lua]
indent_style = space
indent_size = 4
max_line_length = 120

[*.md]
trim_trailing_whitespace = false

[*.{xml,json,toml,yml,yaml}]
indent_style = space
indent_size = 2

# Third-party file, kept byte-identical to upstream.
[scripts/tools/upvaluehacker.lua]
indent_style = tab
end_of_line = crlf
insert_final_newline = false

[*.{tex,png,dyn,zip,ksh}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
